  updateBenchmarks(result) {
    this.benchmarks.lastNValidations.push({
      duration: result.duration,
      status: result.status,
      timestamp: Date.now()
    });
    
    // Keep only last 10 validations
    if (this.benchmarks.lastNValidations.length > 10) {
      this.benchmarks.lastNValidations.shift();
    }
    
    // Update averages
    const validDurations = this.benchmarks.lastNValidations
      .filter(v => v.duration > 0)
      .map(v => v.duration);
    
    if (validDurations.length > 0) {
      this.benchmarks.averageValidationTime = Math.round(
        validDurations.reduce((a, b) => a + b, 0) / validDurations.length
      );
    }
    
    // Update success rate
    const successfulValidations = this.benchmarks.lastNValidations
      .filter(v => v.status === 'PASS' || v.status === 'WARN').length;
    
    this.benchmarks.successRate = Math.round(
      (successfulValidations / this.benchmarks.lastNValidations.length) * 100
    );
  }


