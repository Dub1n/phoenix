   */
  async executeAdvancedTest(name, description, testFunction, projectInfo, options = {}) {
    const testStartTime = Date.now();
    const testId = this.generateTestId(name);
    
    console.log(`    ${description}... [${testId}]`);
    
    const test = {
      id: testId,
      name,
      status: 'PENDING',
      message: '',
      evidence: [],
      errors: [],
      warnings: [],
      recommendations: [],
      metadata: {
        startTime: new Date().toISOString(),
        duration: 0,
        resourceUsage: {}
      }
    };

    try {
      // Start resource monitoring for this test
      const resourceStart = process.memoryUsage();
      
      const testResult = await testFunction(projectInfo, options);
      
      // Calculate resource usage
      const resourceEnd = process.memoryUsage();
      test.metadata.resourceUsage = {
        heapUsed: resourceEnd.heapUsed - resourceStart.heapUsed,
        heapTotal: resourceEnd.heapTotal - resourceStart.heapTotal,
        external: resourceEnd.external - resourceStart.external
      };
      
      if (testResult.success !== false) {
        test.status = testResult.status || 'PASS';
        test.message = testResult.message || `${description} completed successfully`;
        if (testResult.evidence) test.evidence.push(...testResult.evidence);
        if (testResult.warnings) test.warnings.push(...testResult.warnings);
        if (testResult.recommendations) test.recommendations.push(...testResult.recommendations);
        console.log(`      ${test.status === 'PASS' ? '✅' : '🟡'} ${test.status} - ${test.message} [${testId}]`);
      } else {
        test.status = 'FAIL';
        test.message = testResult.message || `${description} failed`;
        if (testResult.errors) test.errors.push(...testResult.errors);
        console.log(`      ❌ FAIL - ${test.message} [${testId}]`);
      }

    } catch (error) {
      test.status = 'FAIL';
      test.message = `${description} failed with error`;
      test.errors.push(`${description} error: ${error.message}`);
      console.log(`      ❌ FAIL - ${error.message} [${testId}]`);
    } finally {
      test.metadata.duration = Date.now() - testStartTime;
      test.metadata.endTime = new Date().toISOString();
    }

    return test;
  }

  /**
   * Execute command with advanced monitoring and retry logic
   */
  async executeAdvancedCommand(command, description, projectInfo, options = {}) {
    const maxRetries = options.retries || 2;
    let attempt = 0;
    
    while (attempt <= maxRetries) {
      try {
        const originalCwd = process.cwd();
        process.chdir(projectInfo.path);

        console.log(`      Command: ${command} (attempt ${attempt + 1}/${maxRetries + 1})`);
        
        const startTime = Date.now();
        const output = execSync(command, {
          encoding: 'utf8',
          timeout: options.timeout || 120000,
          maxBuffer: options.maxBuffer || (2 * 1024 * 1024),
          env: { ...process.env, ...(options.env || {}) }
        });
        const duration = Date.now() - startTime;

        process.chdir(originalCwd);

        return {
          success: true,
          output: output.trim(),
          duration,
          attempt: attempt + 1,
          evidence: [
            `Command executed successfully: ${command}`,
            `Output length: ${output.length} characters`,
            `Execution time: ${duration}ms`,
            `Attempt: ${attempt + 1}/${maxRetries + 1}`
          ]
        };

      } catch (error) {
        process.chdir(process.cwd());
        attempt++;
        
        if (attempt > maxRetries) {
          return {
            success: false,
            errors: [
              `Command failed after ${maxRetries + 1} attempts: ${command}`,
              `Final error: ${error.message}`
            ],
            evidence: [`Command attempted: ${command}`, `Total attempts: ${maxRetries + 1}`]
          };
        }
        
        // Wait before retry with exponential backoff
        const backoffMs = Math.min(1000 * Math.pow(2, attempt - 1), 10000);
        console.log(`      Retrying in ${backoffMs}ms...`);
        await new Promise(resolve => setTimeout(resolve, backoffMs));
      }
    }
  }

