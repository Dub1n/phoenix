    return {
      memory: {
        heapUsed: memoryEnd.heapUsed - this.resourceMonitoring.memoryStart.heapUsed,
        heapTotal: memoryEnd.heapTotal - this.resourceMonitoring.memoryStart.heapTotal,
        external: memoryEnd.external - this.resourceMonitoring.memoryStart.external,
        rss: memoryEnd.rss - this.resourceMonitoring.memoryStart.rss
