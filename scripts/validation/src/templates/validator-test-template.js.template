    };

    try {
      const testResult = await testFunction(projectInfo, options);
      
      if (testResult.success !== false) {
        test.status = testResult.status || 'PASS';
        test.message = testResult.message || `${description} completed successfully`;
        if (testResult.evidence) test.evidence.push(...testResult.evidence);
        if (testResult.warnings) test.warnings.push(...testResult.warnings);
        console.log(`      ✅ ${test.status} - ${test.message}`);
      } else {
        test.status = 'FAIL';
        test.message = testResult.message || `${description} failed`;
        if (testResult.errors) test.errors.push(...testResult.errors);
        console.log(`      ❌ FAIL - ${test.message}`);
      }

    } catch (error) {
      test.status = 'FAIL';
      test.message = `${description} failed with error`;
      test.errors.push(`${description} error: ${error.message}`);
      console.log(`      ❌ FAIL - ${error.message}`);
    } finally {
      test.testingMetadata.executionTime = Date.now() - testStartTime;
      
      // Log test execution for performance analysis
      this.testExecutionLog.push({
        name,
        status: test.status,
        executionTime: test.testingMetadata.executionTime,
        timestamp: new Date().toISOString()
      });
    }

    return test;
  }

  /**
   * Execute test command with framework-specific handling
   */
  async executeTestCommand(command, framework, projectInfo, options = {}) {
    try {
      const originalCwd = process.cwd();
      process.chdir(projectInfo.path);

      console.log(`      Test Command (${framework}): ${command}`);
      const output = execSync(command, {
        encoding: 'utf8',
        timeout: options.timeout || 180000, // 3 minutes for tests
        maxBuffer: options.maxBuffer || (2 * 1024 * 1024)
      });

      process.chdir(originalCwd);

      // Parse framework-specific output
      const parsedResults = this.parseTestOutput(output, framework);

      return {
        success: true,
        output: output.trim(),
        parsedResults,
        evidence: [
          `Test command executed successfully: ${command}`,
          `Framework: ${framework}`,
          `Output length: ${output.length} characters`
        ]
      };

    } catch (error) {
      process.chdir(process.cwd());
      
      return {
        success: false,
        errors: [`Test command failed: ${command}`, `Framework: ${framework}`, `Error: ${error.message}`],
        evidence: [`Test command attempted: ${command}`]
      };
    }
  }

  // Test-specific utility methods
  async detectFramework(projectInfo, framework) {
    const found = { found: false, configPaths: [] };
    
    for (const file of framework.files) {
      const filePath = path.join(projectInfo.path, file);
      if (fs.existsSync(filePath)) {
        found.found = true;
        found.configPaths.push(filePath);
      }
    }
    
    // Check package.json for framework dependencies
    const packageJsonPath = path.join(projectInfo.path, 'package.json');
    if (fs.existsSync(packageJsonPath)) {
      try {
        const packageJson = JSON.parse(fs.readFileSync(packageJsonPath, 'utf8'));
        const allDeps = { 
          ...packageJson.dependencies, 
          ...packageJson.devDependencies 
        };
        
        for (const pattern of framework.patterns) {
          if (Object.keys(allDeps).some(dep => dep.includes(pattern))) {
            found.found = true;
            break;
          }
        }
      } catch (error) {
        // Ignore package.json parse errors
      }
    }
    
    return found;
  }

  async runCoverageAnalysis(projectInfo, framework) {
    const coverageCommands = {
      'Jest': 'npx jest --coverage --passWithNoTests',
      'Mocha': 'npx nyc mocha',
      'Vitest': 'npx vitest --coverage'
    };
    
    const command = coverageCommands[framework];
    if (!command) {
      return { success: false, error: `No coverage command for ${framework}` };
    }
    
    try {
      const result = await this.executeTestCommand(command, framework, projectInfo, { timeout: 300000 });
      return {
        success: result.success,
        data: this.parseCoverageOutput(result.output, framework)
      };
    } catch (error) {
      return { success: false, error: error.message };
    }
  }

  parseCoverageOutput(output, framework) {
    // Basic coverage parsing - would need framework-specific implementation
    const coverageMatch = output.match(/(\d+\.?\d*)%/);
    const coverage = coverageMatch ? parseFloat(coverageMatch[1]) : 0;
    
    return {
      coverage,
      totalTests: (output.match(/\d+ tests?/gi) || []).length,
      passedTests: (output.match(/\d+ passed/gi) || []).length,
      failedTests: (output.match(/\d+ failed/gi) || []).length,
      skippedTests: (output.match(/\d+ skipped/gi) || []).length
    };
  }

