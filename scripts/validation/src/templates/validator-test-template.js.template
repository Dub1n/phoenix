  /**
   * Calculate testing-specific validation score
   */
  async calculateTestingScore(result) {
    const failedTests = result.tests.filter(t => t.status === 'FAIL');
    const passedTests = result.tests.filter(t => t.status === 'PASS');
    const warnTests = result.tests.filter(t => t.status === 'WARN');
    const skippedTests = result.tests.filter(t => t.status === 'SKIP');
    
    // Test-specific scoring criteria
    let score = 0;
    const maxScore = 100;
    
    // Framework presence (20 points)
    score += this.detectedTestFrameworks.size > 0 ? 20 : 0;
    
    // Test coverage (30 points)
    score += Math.min(30, (this.testCoverageData.coverage / 100) * 30);
    
    // Test execution success (30 points)
    const totalTests = result.tests.length;
    if (totalTests > 0) {
      score += (passedTests.length / totalTests) * 30;
    }
    
    // Best practices compliance (20 points)
    const bestPracticesTests = result.tests.filter(t => 
      ['Test Organization', 'Test Naming Conventions', 'Test Isolation', 'Mock Usage'].includes(t.name)
    );
    const passedBestPractices = bestPracticesTests.filter(t => t.status === 'PASS');
    if (bestPracticesTests.length > 0) {
      score += (passedBestPractices.length / bestPracticesTests.length) * 20;
    }
    
    result.testingMetadata.testingScore = Math.round(score);
    
    // Determine status based on testing criteria
    if (failedTests.length > 0 || score < 40) {
      result.status = 'FAIL';
    } else if (score < 70 || warnTests.length > 0) {
      result.status = 'WARN';
    } else {
      result.status = 'PASS';
    }
    
    // Collect evidence and errors from tests
    for (const test of result.tests) {
      if (test.evidence) result.evidence.push(...test.evidence);
      if (test.errors) result.errors.push(...test.errors);
      if (test.warnings) result.warnings.push(...test.warnings);
    }
  }

