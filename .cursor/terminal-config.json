{
    "Referenced in": "enhanced-terminal-manager.ps1, auto-terminal-manager.ps1",
    "Contains": "Timeout settings, process management, command overrides, heartbeat settings",
    "Purpose": "Custom terminal management script configuration",
    "--------------------------------": "--------------------------------",
    "timeout": {
        "default": 30000,
        "short": 10000,
        "long": 120000
    },
    "processManagement": {
        "autoKillHanging": true,
        "killTimeout": 5000
    },
    "commands": {
        "npm": {
            "test": {
                "timeout": 60000,
                "background": false,
                "retry": 2
            }
        },
        "node": {
            "timeout": 30000,
            "background": false
        },
        "git": {
            "timeout": 15000,
            "background": false
        }
    },
    "patterns": {
        "hanging": [
            "node.exe",
            "npm.cmd",
            "tsc.exe"
        ],
        "safe": [
            "git",
            "echo",
            "dir",
            "ls"
        ]
    },
    "enhanced_monitoring": {
        "enabled": true,
        "output_tracking": {
            "check_interval": 1000,
            "min_change_threshold": 10,
            "max_buffer_size": 10000,
            "change_timeout": 30000,
            "pattern_match_timeout": 15000
        }
    },
    "// Heartbeat configuration - redesigned architecture with terminal-specific output": "",
    "heartbeat": {
        "enabled": true,
        "version": "2.0",
        "architecture": "background_runspace",
        "interval_ms": 1000,
        "status_symbols": [
            "◓",
            "◑",
            "◒",
            "◐"
        ],
        "max_heartbeats": 300,
        "auto_restart": true,
        "background_mode": true,
        "terminal_only": true,
        "non_blocking": true,
        "lifecycle_management": {
            "enabled": true,
            "multi_terminal_support": true,
            "automatic_cleanup": true,
            "session_tracking": true,
            "reference_counting": true
        },
        "output_method": "ansi_console",
        "cleanup_on_exit": true,
        "agent_detection": {
            "methods": [
                "environment_variables",
                "process_tree",
                "workspace_context",
                "cursor_processes"
            ],
            "strict_mode": false
        }
    },
    "command_overrides": {
        "npm": {
            "enabled": true,
            "timeout_ms": 60000
        },
        "node": {
            " enabled": true,
            " timeout_ms": 30000
        },
        "git": {
            "enabled": true,
            "timeout_ms": 15000
        },
        "tsc": {
            "enabled": true,
            "timeout_ms": 30000
        },
        "jest": {
            "enabled": true,
            "timeout_ms": 60000
        }
    }
}
