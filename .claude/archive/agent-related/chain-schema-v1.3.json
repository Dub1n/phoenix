{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chain Engineer v1.3 Risk-Adaptive Chain Handoff Format",
  "description": "Standardized format for risk-aware chain design, execution tracking, and post-mortem analysis",
  "version": "1.3.0",
  
  "type": "object",
  "required": ["chain_identity", "risk_profile", "adaptive_design", "execution_resilience", "probabilistic_outcomes"],
  
  "properties": {
    
    "chain_identity": {
      "description": "Core identification and context for the chain execution",
      "type": "object",
      "required": ["chain_id", "timestamp", "chain_engineer_version", "task_complexity_class"],
      "properties": {
        "chain_id": {
          "type": "string",
          "description": "Unique identifier for this chain execution"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when chain design was initiated"
        },
        "chain_engineer_version": {
          "type": "string",
          "description": "Version of Chain Engineer agent (e.g., 'v1.3-risk-adaptive')"
        },
        "task_complexity_class": {
          "type": "string",
          "enum": ["simple", "moderate", "complex", "critical"],
          "description": "Complexity classification affecting risk tolerance thresholds"
        },
        "environmental_context": {
          "type": "object",
          "description": "External factors influencing risk assessment",
          "properties": {
            "resource_availability": {
              "type": "string",
              "enum": ["abundant", "normal", "constrained", "critical"]
            },
            "timeline_pressure": {
              "type": "string", 
              "enum": ["relaxed", "normal", "urgent", "emergency"]
            },
            "stakeholder_risk_tolerance": {
              "type": "string",
              "enum": ["high", "moderate", "low", "minimal"]
            }
          }
        }
      }
    },

    "risk_profile": {
      "description": "Comprehensive risk assessment across all phases of execution",
      "type": "object",
      "required": ["overall_risk_score", "primary_risk_factors", "compound_risks"],
      "properties": {
        "overall_risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Aggregate risk score (0=minimal, 100=extreme risk)"
        },
        "confidence_in_assessment": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Confidence level in the risk assessment itself"
        },
        "primary_risk_factors": {
          "type": "array",
          "description": "Top risk factors identified during analysis",
          "items": {
            "type": "object",
            "required": ["risk_type", "probability", "impact_severity", "mitigation_strategy"],
            "properties": {
              "risk_type": {
                "type": "string",
                "enum": [
                  "technical_complexity", "resource_contention", "dependency_failure",
                  "timeline_overrun", "scope_creep", "integration_failure",
                  "validation_failure", "cascade_failure", "external_dependency"
                ]
              },
              "probability": {
                "type": "object",
                "description": "Probability distribution of risk occurrence",
                "properties": {
                  "point_estimate": {"type": "number", "minimum": 0, "maximum": 1},
                  "confidence_interval_90": {
                    "type": "array",
                    "items": {"type": "number", "minimum": 0, "maximum": 1},
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "distribution_type": {
                    "type": "string",
                    "enum": ["beta", "normal", "uniform", "triangular"]
                  }
                }
              },
              "impact_severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "mitigation_strategy": {
                "type": "string",
                "description": "Primary strategy to reduce this risk"
              },
              "residual_risk_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Risk level after mitigation measures"
              }
            }
          }
        },
        "compound_risks": {
          "type": "array",
          "description": "Risks that emerge from combinations of individual risks",
          "items": {
            "type": "object",
            "properties": {
              "component_risks": {
                "type": "array",
                "items": {"type": "string"}
              },
              "compound_probability": {"type": "number", "minimum": 0, "maximum": 1},
              "amplification_factor": {"type": "number", "minimum": 1}
            }
          }
        },
        "risk_evolution_timeline": {
          "type": "array",
          "description": "How risk levels change throughout execution",
          "items": {
            "type": "object",
            "properties": {
              "phase": {"type": "string"},
              "risk_score": {"type": "number"},
              "key_risk_drivers": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },

    "adaptive_design": {
      "description": "How the chain is designed to handle uncertainty and adapt to changing conditions",
      "type": "object",
      "required": ["fallback_architecture", "monitoring_framework", "adaptation_triggers"],
      "properties": {
        "fallback_architecture": {
          "type": "object",
          "description": "Multi-layer fallback strategy design",
          "required": ["layers"],
          "properties": {
            "layers": {
              "type": "array",
              "description": "Ordered fallback layers from primary to emergency",
              "items": {
                "type": "object",
                "required": ["layer_name", "trigger_conditions", "success_probability", "expected_performance"],
                "properties": {
                  "layer_name": {"type": "string"},
                  "layer_type": {
                    "type": "string",
                    "enum": ["primary", "secondary", "tertiary", "emergency", "manual"]
                  },
                  "trigger_conditions": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "success_probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "expected_performance": {
                    "type": "object",
                    "properties": {
                      "duration_estimate": {
                        "type": "object",
                        "properties": {
                          "optimistic": {"type": "number"},
                          "most_likely": {"type": "number"},
                          "pessimistic": {"type": "number"}
                        }
                      },
                      "quality_level": {
                        "type": "string",
                        "enum": ["optimal", "acceptable", "minimum", "degraded"]
                      }
                    }
                  },
                  "resource_requirements": {
                    "type": "object",
                    "properties": {
                      "agent_count": {"type": "integer"},
                      "computational_intensity": {
                        "type": "string",
                        "enum": ["low", "moderate", "high", "intensive"]
                      },
                      "external_dependencies": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                }
              }
            },
            "layer_transition_logic": {
              "type": "string",
              "description": "Rules governing when to escalate between fallback layers"
            }
          }
        },
        "monitoring_framework": {
          "type": "object",
          "description": "Real-time monitoring and early warning systems",
          "properties": {
            "checkpoint_schedule": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "checkpoint_id": {"type": "string"},
                  "phase": {"type": "string"},
                  "completion_percentage": {"type": "number"},
                  "success_criteria": {"type": "array", "items": {"type": "string"}},
                  "failure_escalation_rules": {"type": "string"}
                }
              }
            },
            "performance_indicators": {
              "type": "array",
              "description": "Metrics tracked for adaptation decisions",
              "items": {
                "type": "object",
                "properties": {
                  "metric_name": {"type": "string"},
                  "measurement_frequency": {"type": "string"},
                  "normal_range": {
                    "type": "object",
                    "properties": {
                      "min": {"type": "number"},
                      "max": {"type": "number"}
                    }
                  },
                  "warning_thresholds": {
                    "type": "object",
                    "properties": {
                      "yellow": {"type": "number"},
                      "red": {"type": "number"}
                    }
                  }
                }
              }
            }
          }
        },
        "adaptation_triggers": {
          "type": "array",
          "description": "Conditions that trigger real-time adaptations",
          "items": {
            "type": "object",
            "required": ["trigger_name", "condition", "adaptation_response"],
            "properties": {
              "trigger_name": {"type": "string"},
              "condition": {"type": "string"},
              "adaptation_response": {"type": "string"},
              "response_time_target": {
                "type": "number",
                "description": "Target time in seconds to implement adaptation"
              },
              "success_rate_history": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Historical success rate of this adaptation"
              }
            }
          }
        },
        "graceful_degradation": {
          "type": "object",
          "description": "How functionality degrades under adverse conditions",
          "properties": {
            "degradation_levels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "level_name": {"type": "string"},
                  "functionality_percentage": {"type": "number"},
                  "quality_impact": {"type": "string"},
                  "trigger_conditions": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        }
      }
    },

    "execution_resilience": {
      "description": "Tracking of actual adaptation and recovery during execution",
      "type": "object",
      "properties": {
        "real_time_adaptations": {
          "type": "array",
          "description": "Adaptations made during execution",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "trigger_event": {"type": "string"},
              "adaptation_made": {"type": "string"},
              "effectiveness_score": {"type": "number", "minimum": 0, "maximum": 100},
              "recovery_time_seconds": {"type": "number"},
              "impact_on_timeline": {"type": "number"}
            }
          }
        },
        "fallback_activations": {
          "type": "array",
          "description": "Record of fallback layer activations",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "from_layer": {"type": "string"},
              "to_layer": {"type": "string"},
              "trigger_reason": {"type": "string"},
              "activation_success": {"type": "boolean"},
              "performance_impact": {
                "type": "object",
                "properties": {
                  "duration_change_percentage": {"type": "number"},
                  "quality_change": {"type": "string", "enum": ["improved", "maintained", "degraded"]}
                }
              }
            }
          }
        },
        "recovery_events": {
          "type": "array",
          "description": "Successful recoveries from failure states",
          "items": {
            "type": "object",
            "properties": {
              "failure_type": {"type": "string"},
              "failure_detection_time": {"type": "number"},
              "recovery_strategy_used": {"type": "string"},
              "total_recovery_time": {"type": "number"},
              "data_preservation_success": {"type": "boolean"},
              "lessons_learned": {"type": "string"}
            }
          }
        },
        "cascade_prevention": {
          "type": "object",
          "description": "Tracking of prevented cascade failures",
          "properties": {
            "prevented_cascades": {"type": "integer"},
            "isolation_effectiveness": {"type": "number", "minimum": 0, "maximum": 100},
            "circuit_breaker_activations": {"type": "integer"}
          }
        }
      }
    },

    "probabilistic_outcomes": {
      "description": "Uncertainty-aware outcome analysis with confidence intervals",
      "type": "object",
      "required": ["completion_probability", "duration_distribution", "quality_distribution"],
      "properties": {
        "completion_probability": {
          "type": "object",
          "description": "Probability of various completion scenarios",
          "properties": {
            "full_success": {"type": "number", "minimum": 0, "maximum": 1},
            "partial_success": {"type": "number", "minimum": 0, "maximum": 1},
            "minimal_success": {"type": "number", "minimum": 0, "maximum": 1},
            "failure": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "duration_distribution": {
          "type": "object",
          "description": "Probabilistic duration estimates",
          "properties": {
            "percentile_10": {"type": "number"},
            "percentile_25": {"type": "number"},
            "percentile_50": {"type": "number"},
            "percentile_75": {"type": "number"},
            "percentile_90": {"type": "number"},
            "confidence_interval_80": {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "quality_distribution": {
          "type": "object",
          "description": "Expected quality outcome probabilities",
          "properties": {
            "exceeds_expectations": {"type": "number", "minimum": 0, "maximum": 1},
            "meets_expectations": {"type": "number", "minimum": 0, "maximum": 1},
            "acceptable_quality": {"type": "number", "minimum": 0, "maximum": 1},
            "below_acceptable": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "uncertainty_factors": {
          "type": "array",
          "description": "Key sources of uncertainty affecting outcomes",
          "items": {
            "type": "object",
            "properties": {
              "factor_name": {"type": "string"},
              "uncertainty_level": {"type": "string", "enum": ["low", "moderate", "high", "extreme"]},
              "impact_on_outcomes": {"type": "string"},
              "mitigation_approach": {"type": "string"}
            }
          }
        }
      }
    },

    "learning_intelligence": {
      "description": "Knowledge gained and learning opportunities from this execution",
      "type": "object",
      "properties": {
        "risk_model_updates": {
          "type": "array",
          "description": "Refinements to risk assessment models based on actual outcomes",
          "items": {
            "type": "object",
            "properties": {
              "model_component": {"type": "string"},
              "observed_vs_predicted": {"type": "string"},
              "calibration_adjustment": {"type": "string"},
              "confidence_in_update": {"type": "number", "minimum": 0, "maximum": 100}
            }
          }
        },
        "adaptation_strategy_effectiveness": {
          "type": "array",
          "description": "Evaluation of adaptation strategies used",
          "items": {
            "type": "object",
            "properties": {
              "strategy_name": {"type": "string"},
              "usage_frequency": {"type": "integer"},
              "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
              "average_recovery_time": {"type": "number"},
              "recommendation": {"type": "string", "enum": ["keep", "modify", "replace", "expand"]}
            }
          }
        },
        "pattern_recognition": {
          "type": "object",
          "description": "Patterns identified for future chain design",
          "properties": {
            "successful_patterns": {"type": "array", "items": {"type": "string"}},
            "failure_patterns": {"type": "array", "items": {"type": "string"}},
            "emerging_patterns": {"type": "array", "items": {"type": "string"}}
          }
        },
        "predictive_model_accuracy": {
          "type": "object",
          "description": "How accurate were the predictions vs. actual outcomes",
          "properties": {
            "duration_prediction_error": {"type": "number"},
            "risk_assessment_accuracy": {"type": "number", "minimum": 0, "maximum": 100},
            "adaptation_trigger_precision": {"type": "number", "minimum": 0, "maximum": 100}
          }
        }
      }
    },

    "cascade_analysis": {
      "description": "Analysis of failure propagation and prevention mechanisms",
      "type": "object",
      "properties": {
        "failure_propagation_mapping": {
          "type": "array",
          "description": "How failures spread through the chain",
          "items": {
            "type": "object",
            "properties": {
              "origin_point": {"type": "string"},
              "propagation_path": {"type": "array", "items": {"type": "string"}},
              "containment_point": {"type": "string"},
              "prevention_mechanism": {"type": "string"}
            }
          }
        },
        "isolation_effectiveness": {
          "type": "object",
          "description": "How well isolation mechanisms worked",
          "properties": {
            "phase_isolation_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "resource_isolation_effectiveness": {"type": "number", "minimum": 0, "maximum": 1},
            "data_isolation_integrity": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "early_warning_performance": {
          "type": "object",
          "description": "Effectiveness of early warning systems",
          "properties": {
            "false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "false_negative_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "average_warning_lead_time": {"type": "number"}
          }
        }
      }
    },

    "stakeholder_impact": {
      "description": "Impact analysis for different stakeholders",
      "type": "object",
      "properties": {
        "user_experience_impact": {
          "type": "object",
          "properties": {
            "perceived_reliability": {"type": "number", "minimum": 0, "maximum": 100},
            "response_time_consistency": {"type": "string", "enum": ["excellent", "good", "acceptable", "poor"]},
            "feature_availability": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "operational_impact": {
          "type": "object",
          "properties": {
            "resource_utilization_efficiency": {"type": "number", "minimum": 0, "maximum": 100},
            "maintenance_overhead": {"type": "string", "enum": ["minimal", "moderate", "significant"]},
            "scalability_implications": {"type": "string"}
          }
        },
        "business_continuity": {
          "type": "object",
          "properties": {
            "service_availability": {"type": "number", "minimum": 0, "maximum": 100},
            "recovery_time_objective_met": {"type": "boolean"},
            "recovery_point_objective_met": {"type": "boolean"}
          }
        }
      }
    },

    "meta_analysis": {
      "description": "Meta-information about the analysis itself",
      "type": "object",
      "properties": {
        "analysis_completion_time": {"type": "string", "format": "date-time"},
        "data_collection_completeness": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence_in_analysis": {"type": "number", "minimum": 0, "maximum": 100},
        "recommended_follow_up_actions": {"type": "array", "items": {"type": "string"}},
        "next_review_date": {"type": "string", "format": "date"},
        "analysis_methodology_version": {"type": "string"}
      }
    }
  },

  "additionalProperties": false,

  "$comment": "Design Philosophy: This format prioritizes uncertainty quantification, adaptive capacity tracking, and predictive learning over traditional execution metrics. It treats risk and adaptation as first-class citizens rather than afterthoughts, enabling continuous improvement of risk-adaptive chain orchestration capabilities."
}