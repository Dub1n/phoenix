{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chain Engineer v1.2 Pattern-Centric Handoff Format",
  "description": "Standardized format for pattern-based chain design handoff and learning analysis",
  "type": "object",
  "required": [
    "handoff_metadata",
    "chain_pattern_analysis", 
    "pattern_execution_tracking",
    "adaptation_analysis",
    "learning_outcomes",
    "pattern_library_updates"
  ],
  "properties": {
    
    "handoff_metadata": {
      "description": "Basic chain identification and context",
      "type": "object",
      "required": ["chain_id", "timestamp", "chain_engineer_version", "task_complexity_signature"],
      "properties": {
        "chain_id": {
          "type": "string",
          "description": "Unique identifier for this chain execution"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Chain design completion timestamp"
        },
        "chain_engineer_version": {
          "type": "string",
          "description": "Version of Chain Engineer that designed this chain",
          "const": "v1.2-pattern-centric"
        },
        "task_complexity_signature": {
          "type": "object",
          "description": "Multi-dimensional complexity fingerprint for pattern matching",
          "properties": {
            "scope_complexity": {"type": "integer", "minimum": 1, "maximum": 10},
            "technical_complexity": {"type": "integer", "minimum": 1, "maximum": 10},
            "coordination_complexity": {"type": "integer", "minimum": 1, "maximum": 10},
            "resource_complexity": {"type": "integer", "minimum": 1, "maximum": 10},
            "time_pressure": {"type": "integer", "minimum": 1, "maximum": 10}
          }
        },
        "estimated_duration_minutes": {
          "type": "number",
          "description": "Pattern-based duration prediction"
        }
      }
    },

    "chain_pattern_analysis": {
      "description": "Core pattern discovery and selection methodology",
      "type": "object",
      "required": ["pattern_discovery", "pattern_selection", "confidence_analysis"],
      "properties": {
        "pattern_discovery": {
          "type": "object",
          "description": "How patterns were identified and evaluated",
          "properties": {
            "candidate_patterns": {
              "type": "array",
              "description": "All patterns considered for this task",
              "items": {
                "type": "object",
                "properties": {
                  "pattern_id": {"type": "string"},
                  "pattern_name": {"type": "string"},
                  "historical_success_rate": {"type": "number", "minimum": 0, "maximum": 100},
                  "task_similarity_score": {"type": "number", "minimum": 0, "maximum": 100},
                  "resource_match_score": {"type": "number", "minimum": 0, "maximum": 100},
                  "overall_confidence_score": {"type": "number", "minimum": 0, "maximum": 100},
                  "rejection_reason": {"type": "string", "description": "Why this pattern wasn't selected"}
                }
              }
            },
            "pattern_discovery_method": {
              "type": "string",
              "enum": ["task_signature_matching", "historical_similarity", "constraint_filtering", "hybrid_analysis"],
              "description": "Primary method used to find candidate patterns"
            },
            "novel_aspects": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Task aspects not well covered by existing patterns"
            }
          }
        },
        
        "pattern_selection": {
          "type": "object",
          "description": "Final pattern choice and justification",
          "required": ["selected_pattern", "selection_rationale"],
          "properties": {
            "selected_pattern": {
              "type": "object",
              "properties": {
                "pattern_id": {"type": "string"},
                "pattern_name": {"type": "string"},
                "pattern_category": {
                  "type": "string",
                  "enum": ["linear_execution", "parallel_processing", "hybrid_coordination", "discovery_consolidation", "iterative_refinement"]
                },
                "historical_metrics": {
                  "type": "object",
                  "properties": {
                    "success_rate": {"type": "number", "minimum": 0, "maximum": 100},
                    "avg_duration_minutes": {"type": "number"},
                    "typical_agent_count": {"type": "integer"},
                    "common_failure_modes": {"type": "array", "items": {"type": "string"}}
                  }
                }
              }
            },
            "selection_rationale": {
              "type": "object",
              "properties": {
                "primary_factors": {"type": "array", "items": {"type": "string"}},
                "risk_assessment": {"type": "string"},
                "alternative_patterns_considered": {"type": "array", "items": {"type": "string"}},
                "confidence_drivers": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        },

        "confidence_analysis": {
          "type": "object",
          "description": "Detailed confidence scoring methodology and results",
          "properties": {
            "overall_confidence_score": {"type": "number", "minimum": 0, "maximum": 100},
            "confidence_breakdown": {
              "type": "object",
              "properties": {
                "pattern_match_confidence": {"type": "number", "minimum": 0, "maximum": 100},
                "historical_data_confidence": {"type": "number", "minimum": 0, "maximum": 100},
                "adaptation_feasibility_confidence": {"type": "number", "minimum": 0, "maximum": 100},
                "resource_availability_confidence": {"type": "number", "minimum": 0, "maximum": 100}
              }
            },
            "confidence_risks": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Factors that could reduce actual success vs predicted confidence"
            }
          }
        }
      }
    },

    "pattern_execution_tracking": {
      "description": "Real-time tracking of pattern performance vs historical expectations",
      "type": "object",
      "properties": {
        "execution_phases": {
          "type": "array",
          "description": "Each phase with pattern-informed tracking",
          "items": {
            "type": "object",
            "properties": {
              "phase_name": {"type": "string"},
              "pattern_expectation": {
                "type": "object",
                "properties": {
                  "expected_duration_minutes": {"type": "number"},
                  "expected_success_rate": {"type": "number", "minimum": 0, "maximum": 100},
                  "expected_agent_count": {"type": "integer"},
                  "known_risk_factors": {"type": "array", "items": {"type": "string"}}
                }
              },
              "actual_execution": {
                "type": "object",
                "properties": {
                  "actual_duration_minutes": {"type": "number"},
                  "success": {"type": "boolean"},
                  "actual_agent_count": {"type": "integer"},
                  "encountered_issues": {"type": "array", "items": {"type": "string"}},
                  "recovery_actions": {"type": "array", "items": {"type": "string"}}
                }
              },
              "pattern_performance_delta": {
                "type": "object",
                "description": "How this phase compared to pattern predictions",
                "properties": {
                  "duration_variance_percent": {"type": "number"},
                  "success_prediction_accuracy": {"type": "boolean"},
                  "unexpected_challenges": {"type": "array", "items": {"type": "string"}},
                  "pattern_effectiveness_score": {"type": "number", "minimum": 0, "maximum": 10}
                }
              }
            }
          }
        },
        
        "overall_execution_metrics": {
          "type": "object",
          "properties": {
            "total_duration_minutes": {"type": "number"},
            "pattern_predicted_duration": {"type": "number"},
            "duration_accuracy_percent": {"type": "number"},
            "overall_success": {"type": "boolean"},
            "pattern_predicted_success_rate": {"type": "number"},
            "prediction_calibration_score": {"type": "number", "minimum": 0, "maximum": 10}
          }
        }
      }
    },

    "adaptation_analysis": {
      "description": "Analysis of pattern customizations and their effectiveness",
      "type": "object",
      "properties": {
        "adaptations_applied": {
          "type": "array",
          "description": "All customizations made to the base pattern",
          "items": {
            "type": "object",
            "properties": {
              "adaptation_type": {
                "type": "string",
                "enum": ["batch_size_optimization", "timeout_adjustment", "validation_level_change", "agent_specialization", "coordination_modification", "resource_scaling"]
              },
              "adaptation_description": {"type": "string"},
              "baseline_value": {"type": "string", "description": "Original pattern parameter"},
              "adapted_value": {"type": "string", "description": "Customized parameter value"},
              "adaptation_rationale": {"type": "string"},
              "effectiveness_assessment": {
                "type": "object",
                "properties": {
                  "improved_performance": {"type": "boolean"},
                  "impact_magnitude": {"type": "integer", "minimum": 1, "maximum": 5},
                  "unintended_consequences": {"type": "array", "items": {"type": "string"}},
                  "future_applicability": {"type": "string", "enum": ["task_specific", "pattern_enhancement", "general_improvement"]}
                }
              }
            }
          }
        },
        
        "adaptation_success_analysis": {
          "type": "object",
          "properties": {
            "overall_adaptation_effectiveness": {"type": "number", "minimum": 0, "maximum": 10},
            "most_successful_adaptation": {"type": "string"},
            "least_successful_adaptation": {"type": "string"},
            "unexpected_adaptation_needs": {"type": "array", "items": {"type": "string"}},
            "adaptation_learning_insights": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },

    "learning_outcomes": {
      "description": "Knowledge gained from this execution for pattern library improvement",
      "type": "object",
      "required": ["pattern_validation_results", "new_insights", "failure_mode_analysis"],
      "properties": {
        "pattern_validation_results": {
          "type": "object",
          "description": "How well the pattern performed vs historical data",
          "properties": {
            "pattern_reliability_confirmed": {"type": "boolean"},
            "success_rate_validation": {
              "type": "object",
              "properties": {
                "historical_success_rate": {"type": "number"},
                "this_execution_success": {"type": "boolean"},
                "updated_success_rate_recommendation": {"type": "number"}
              }
            },
            "duration_accuracy_validation": {
              "type": "object", 
              "properties": {
                "historical_avg_duration": {"type": "number"},
                "this_execution_duration": {"type": "number"},
                "duration_model_accuracy": {"type": "number", "minimum": 0, "maximum": 100}
              }
            }
          }
        },

        "new_insights": {
          "type": "object",
          "properties": {
            "novel_success_factors": {"type": "array", "items": {"type": "string"}},
            "previously_unknown_failure_modes": {"type": "array", "items": {"type": "string"}},
            "improved_adaptation_strategies": {"type": "array", "items": {"type": "string"}},
            "task_pattern_refinements": {"type": "array", "items": {"type": "string"}},
            "cross_pattern_learning": {"type": "array", "items": {"type": "string"}}
          }
        },

        "failure_mode_analysis": {
          "type": "object",
          "properties": {
            "failures_encountered": {"type": "array", "items": {"type": "string"}},
            "pattern_predicted_failures": {"type": "array", "items": {"type": "string"}},
            "novel_failure_modes": {"type": "array", "items": {"type": "string"}},
            "recovery_effectiveness": {
              "type": "object",
              "properties": {
                "attempted_recoveries": {"type": "array", "items": {"type": "string"}},
                "successful_recoveries": {"type": "array", "items": {"type": "string"}},
                "recovery_pattern_updates": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },

    "comparative_performance": {
      "description": "How this execution compares to similar historical patterns",
      "type": "object",
      "properties": {
        "historical_benchmark": {
          "type": "object",
          "properties": {
            "similar_executions_count": {"type": "integer"},
            "benchmark_success_rate": {"type": "number", "minimum": 0, "maximum": 100},
            "benchmark_avg_duration": {"type": "number"},
            "benchmark_quality_score": {"type": "number", "minimum": 0, "maximum": 10}
          }
        },
        
        "performance_comparison": {
          "type": "object",
          "properties": {
            "duration_percentile": {"type": "number", "minimum": 0, "maximum": 100},
            "quality_percentile": {"type": "number", "minimum": 0, "maximum": 100},
            "success_vs_benchmark": {"type": "string", "enum": ["exceeded", "met", "below"]},
            "standout_performance_factors": {"type": "array", "items": {"type": "string"}},
            "performance_regression_factors": {"type": "array", "items": {"type": "string"}}
          }
        },

        "pattern_ranking_impact": {
          "type": "object",
          "description": "How this execution affects pattern selection for future tasks",
          "properties": {
            "pattern_confidence_adjustment": {"type": "number", "description": "Change to pattern confidence score"},
            "pattern_ranking_change": {"type": "string", "enum": ["promoted", "maintained", "demoted"]},
            "competitive_pattern_impact": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },

    "pattern_library_updates": {
      "description": "Specific changes to be made to pattern knowledge base",
      "type": "object",
      "required": ["pattern_metric_updates", "knowledge_base_enhancements"],
      "properties": {
        "pattern_metric_updates": {
          "type": "object",
          "properties": {
            "success_rate_update": {
              "type": "object",
              "properties": {
                "previous_rate": {"type": "number"},
                "new_rate": {"type": "number"},
                "update_method": {"type": "string", "enum": ["exponential_moving_average", "weighted_recent", "full_recalculation"]}
              }
            },
            "duration_model_update": {
              "type": "object",
              "properties": {
                "previous_avg_duration": {"type": "number"},
                "new_avg_duration": {"type": "number"},
                "duration_variance_update": {"type": "number"}
              }
            },
            "adaptation_success_tracking": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "adaptation_type": {"type": "string"},
                  "success_rate_for_adaptation": {"type": "number"},
                  "recommended_default": {"type": "boolean"}
                }
              }
            }
          }
        },

        "knowledge_base_enhancements": {
          "type": "object",
          "properties": {
            "new_failure_modes_to_add": {"type": "array", "items": {"type": "string"}},
            "updated_recovery_strategies": {"type": "array", "items": {"type": "string"}},
            "refined_task_matching_criteria": {"type": "array", "items": {"type": "string"}},
            "improved_complexity_signatures": {"type": "array", "items": {"type": "string"}},
            "cross_pattern_insights": {"type": "array", "items": {"type": "string"}}
          }
        },

        "new_pattern_candidates": {
          "type": "array",
          "description": "Novel patterns discovered from this execution",
          "items": {
            "type": "object",
            "properties": {
              "candidate_pattern_name": {"type": "string"},
              "pattern_characteristics": {"type": "string"},
              "minimum_validation_executions_needed": {"type": "integer"},
              "initial_success_estimate": {"type": "number", "minimum": 0, "maximum": 100}
            }
          }
        }
      }
    },

    "meta_learning": {
      "description": "Higher-order learning about the pattern-centric methodology itself",
      "type": "object",
      "properties": {
        "methodology_effectiveness": {
          "type": "object",
          "properties": {
            "pattern_selection_accuracy": {"type": "number", "minimum": 0, "maximum": 100},
            "confidence_calibration_accuracy": {"type": "number", "minimum": 0, "maximum": 100},
            "adaptation_prediction_accuracy": {"type": "number", "minimum": 0, "maximum": 100},
            "overall_methodology_effectiveness": {"type": "number", "minimum": 0, "maximum": 10}
          }
        },
        
        "methodology_improvement_opportunities": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Ways to improve the pattern-centric approach itself"
        },

        "pattern_library_health": {
          "type": "object",
          "properties": {
            "coverage_gaps_identified": {"type": "array", "items": {"type": "string"}},
            "pattern_redundancy_issues": {"type": "array", "items": {"type": "string"}},
            "quality_assurance_needs": {"type": "array", "items": {"type": "string"}},
            "library_expansion_priorities": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}