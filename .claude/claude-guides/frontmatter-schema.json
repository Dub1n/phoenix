{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Task Frontmatter Schema",
  "description": "Schema for YAML frontmatter. Commenting conventions: TypeScript: /**...*/; JavaScript: /*...*/; Python: '''...'''; Markdown: no comments needed",
  "required": [
    "date",
    "name", 
    "TASK-ID",
    "category",
    "status",
    "patterns",
    "dependencies",
    "tags"
  ],
  "properties": {
    "date": {
      "type": "string",
      "description": "ISO 8601 timestamp in Zulu format",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{6}Z$"
    },
    "name": {
      "type": "string",
      "description": "Task name identifier"
    },
    "TASK-ID": {
      "type": "array",
      "description": "Task identifiers",
      "items": {
        "type": "string",
        "pattern": "^TASK-[A-Z]+-\\d+$"
      },
      "minItems": 1
    },
    "category": {
      "type": "string",
      "description": "Task category classification"
    },
    "status": {
      "type": "array",
      "description": "Task completion status indicators",
      "items": {
        "type": "string",
        "enum": ["[ ]", "[x]", "[~]", "[-]", "[>]", "[<]", "[?]", "[!]", "[F]", "[B]", "[T]"]
      },
      "minItems": 1,
      "maxItems": 1
    },
    "patterns": {
      "type": "array",
      "description": "Design patterns or methodologies applied",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array", 
      "description": "Components or files involved in the task",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Dependencies required for task completion",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "description": "Categorization tags for the task",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": {
    "description": "Custom fields can be added as needed"
  }
}
