{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdl.vault/schemas/consolidation-state.schema.json",
  "title": "Utility Consolidation State Registry",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "patterns"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$",
      "description": "Semantic version for registry schema compatibility checks"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the registry was last written"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/pattern"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "pattern": {
      "type": "object",
      "required": [
        "patternId",
        "name",
        "stage",
        "owner",
        "lanes",
        "handoff",
        "activity"
      ],
      "properties": {
        "patternId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "owner": {
          "type": "object",
          "required": ["agent", "claimedAt"],
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "claimedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Other pattern IDs that must reach specified gates before continuing"
        },
        "stageGates": {
          "type": "object",
          "description": "Per-stage completion metadata",
          "patternProperties": {
            "^[1-7]$": {
              "$ref": "#/definitions/stageGate"
            }
          },
          "additionalProperties": false
        },
        "lanes": {
          "type": "object",
          "patternProperties": {
            "^6[a-d]$": {
              "$ref": "#/definitions/laneState"
            },
            "^4[a-z]$": {
              "$ref": "#/definitions/laneState"
            }
          },
          "additionalProperties": false
        },
        "handoff": {
          "$ref": "#/definitions/handoff"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/noteEntry"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "activity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/activityEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "stageGate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "scheduled",
            "in_progress",
            "blocked",
            "ready",
            "complete",
            "deferred"
          ]
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/approval"
          }
        }
      },
      "additionalProperties": false
    },
    "laneState": {
      "type": "object",
      "required": ["status", "scope", "commands"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "scheduled",
            "in_progress",
            "blocked",
            "needs_verification",
            "ready_for_handoff",
            "complete",
            "deferred",
            "cancelled"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/commandEvidence"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dependencyRef"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "commandEvidence": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "logPath": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "passed", "failed", "skipped"]
        },
        "executedAt": {
          "type": "string",
          "format": "date-time"
        },
        "exitCode": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dependencyRef": {
      "type": "object",
      "required": ["patternId", "gate"],
      "properties": {
        "patternId": {
          "type": "integer",
          "minimum": 1
        },
        "gate": {
          "type": "string",
          "description": "Stage or lane that must be satisfied",
          "pattern": "^(stage-[1-7]|lane-[46][a-z])$"
        }
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["guardrails", "sharedFiles", "acknowledgements"],
      "properties": {
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sharedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acknowledgements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/approval"
          }
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["agent", "timestamp"],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "activityEntry": {
      "type": "object",
      "required": ["stage", "timestamp", "summary"],
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^(stage-[1-7]|lane-[46][a-z])$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["log", "screenshot", "document", "link"]
        },
        "path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "noteEntry": {
      "type": "object",
      "required": ["id", "timestamp", "body"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
