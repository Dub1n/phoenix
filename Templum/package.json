{
  "name": "templum",
  "displayName": "Templum",
  "publisher": "infotopology",
  "version": "1.0.0",
  "description": "Universal interface orchestrator for multi-backend services",
  "main": "dist/src/index.js",
  "engines": {
    "vscode": "^1.74.0"
  },
  "bin": {
    "templum": "./dist/src/cli-entry.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "templum",
          "title": "Templum",
          "icon": "$(symbol-interface)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "templum.serviceTree",
          "name": "Backend Services",
          "when": "workspaceFolderCount > 0",
          "contextualTitle": "Templum Backend Services"
        }
      ],
      "templum": [
        {
          "type": "webview",
          "id": "templum.universalInterface",
          "name": "Universal Interface"
        },
        {
          "type": "webview",
          "id": "templum.serviceStatus",
          "name": "Service Status"
        },
        {
          "type": "webview",
          "id": "templum.sessionManager",
          "name": "Session Manager"
        }
      ]
    },
    "commands": [
      {
        "command": "templum.refreshAll",
        "title": "Templum: Refresh All Services"
      },
      {
        "command": "templum.showServiceStatus",
        "title": "Templum: Show Service Status"
      },
      {
        "command": "templum.switchInterface",
        "title": "Templum: Switch Interface Mode"
      },
      {
        "command": "templum.refreshServiceTree",
        "title": "Templum: Refresh Service Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "templum.connectService",
        "title": "Templum: Connect to Service"
      },
      {
        "command": "templum.disconnectService",
        "title": "Templum: Disconnect Service"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "templum.refreshServiceTree",
          "when": "view == templum.serviceTree",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "build:component": "node ../scripts/validation/component-build.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:ci": "node scripts/run-jest-ci.mjs && node scripts/run-jest-ci.mjs --runTestsByPath src/tests/backend/manual-override-flow.test.ts src/tests/backend/manual-override-watcher.integration.test.ts --no-cache",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "start": "node dist/src/index.js",
    "start:service": "node dist/src/index.js",
    "start:cli": "node dist/src/cli-entry.js",
    "prepublishOnly": "npm run build",
    "phase6-validation": "npm run build && node dist/src/scripts/run-phase6-integration-validation.js run",
    "phase6-validation:full": "node scripts/run-phase6-full.js",
    "phase6-validation:real": "npm run build && node dist/src/scripts/run-phase6-integration-validation.js run --use-real-backends",
    "phase6-health": "npm run build && node dist/src/scripts/run-phase6-integration-validation.js health",
    "phase6-health:real": "npm run build && node dist/src/scripts/run-phase6-integration-validation.js health --use-real-backends",
    "phase6-services": "npm run build && node dist/src/scripts/run-phase6-integration-validation.js services",
    "check:types": "node scripts/check-types.js",
    "check:tests": "node scripts/check-tests.js",
    "test:health": "node scripts/test-health-monitor.js",
    "test:health-status": "node scripts/test-health-monitor.js status",
    "coverage:reality-check": "node scripts/coverage-reality-check.js",
    "prepare": "cd .. && husky install Templum/.husky || true",
    "consolidate": "node dev/architecture/consolidation-scripts/cli-command-stub.mjs",
    "precommit": "npm run check:types && npm run check:tests && npm run test:health",
    "generate:pattern-readme": "ts-node dev/patterns/scripts/generate-readme.ts"
  },
  "keywords": [
    "templum",
    "universal-interface",
    "orchestrator",
    "multi-backend",
    "vscode",
    "cli",
    "command-line"
  ],
  "author": "VDL Vault",
  "license": "MIT",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "inquirer": "^12.9.0",
    "ora": "^5.4.1",
    "uuid": "^11.1.0",
    "ws": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/inquirer": "^9.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.1.0",
    "@types/vscode": "^1.74.0",
    "@types/ws": "^8.5.10",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^9.32.0",
    "eslint-formatter-compact": "^8.40.0",
    "husky": "^8.0.3",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "why-is-node-running": "^3.2.2",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "glob": "^10.0.0"
  }
}
